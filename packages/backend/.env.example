# Neon-managed variables (DATABASE_URL, DATABASE_URL_UNPOOLED) are written by
# `neon deploy` / `neon env pull` to the repo-root .env.local. The backend
# loads that file first, so they normally do not belong in this package .env.

# ---- Better Auth (self-managed) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- GitHub OAuth App (workspace GitHub Connection) ----
# Create one OAuth App per deployment. Homepage: the frontend URL.
# Callback URL: http://localhost:3000/api/auth/callback/github
# The connect flow asks for the `repo` scope; the token is read-only in the
# product and stored encrypted with INTEGRATION_ENCRYPTION_KEY. This supersedes
# the old manual `github_install` repository list: after upgrading, connect
# GitHub and select repositories in Settings -> Connections -> GitHub.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 32-byte base64 key for integration secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Leave unset to keep the GitHub Connection disabled (connect answers 503).
INTEGRATION_ENCRYPTION_KEY=""

# Optional: require an HMAC signature on POST /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=""

# ---- Mail (invites + notification email) ----
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587 (smtps:// for TLS).
# Leave SMTP_URL unset to keep invites on the copy-link path and skip notification mail.
SMTP_URL=""
MAIL_FROM="zConnect <no-reply@example.com>"

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ---- Redis (BullMQ) ----
# Required for the worker and GitHub webhooks. The API runs without it;
# polling is the realtime fallback when live queries are unavailable.
REDIS_URL="redis://localhost:6379"

# ---- Frontend origin (CORS) ----
# Comma-separated list, so a deploy can name several. When any entry is a
# localhost origin, ports 5173-5179 are trusted too - Vite walks them when its
# default is taken. See src/lib/origins.ts.
FRONTEND_URL="http://localhost:5173"
